#!/usr/bin/env bash
# Host-side installer; Herdr remains the owner of its official Pi extension.
set -euo pipefail
script="$(realpath -- "${BASH_SOURCE[0]}")"
setup="$(dirname -- "$(dirname -- "$script")")"
root="$(dirname -- "$setup")"
config="$root/data/config"
extension="$config/extensions/herdr-agent-state.ts"
source "$setup/lib/herdr-extension.sh"

usage() {
  printf '%s\n' 'Usage: setup/bin/herdr-extension [install|uninstall|ensure]
       setup/bin/herdr-extension --help

Run on the host, from any working directory (symlinks are supported).
With no argument, install/update the official Herdr Pi extension.
ensure checks upstream status and installs only when missing or outdated.
All changes are serialized with other Docker-Pi integration preparations.
The script sets PI_CODING_AGENT_DIR for its Herdr invocation only; it never
sets fake pane variables or changes your shell environment.

Herdr must already be installed. Uses executable HERDR_BIN_PATH when supplied,
otherwise herdr on PATH. No Docker, active pane, or image rebuild is needed.
Uninstall removes only the Herdr-managed extension, not credentials or sessions.'
  printf '\nDeployment configuration: %q\nManaged extension: %q\n' "$config" "$extension"
}

fail() { printf 'herdr-extension: %s\n' "$*" >&2; exit 2; }
[[ $# -le 1 ]] || fail "Expected at most one action. Use --help for usage."
case "${1:-install}" in
  --help|-h) usage; exit 0 ;;
  install|uninstall|ensure) action="${1:-install}" ;;
  *) fail "Unknown action: $1. Use install, uninstall, ensure, or --help." ;;
esac
[[ "$(uname -s)" == Linux ]] || fail "This Docker-Pi integration currently supports local Linux hosts only."

# An unconfigured deployment needs no uninstall and must not create private state.
if [[ "$action" == uninstall && ! -e "$config" && ! -L "$config" ]]; then
  printf 'No Docker-Pi configuration at %q; nothing to uninstall.\n' "$config"
  exit 0
fi

herdr_resolve_binary || exit 2
command -v flock >/dev/null 2>&1 || fail "flock is required for safe shared integration preparation (install util-linux on the host)."

if [[ "$action" != uninstall ]]; then
  # Do not change permissions or contents of existing shared configuration.
  (umask 077; mkdir -p -- "$config") \
    || fail "Cannot create $config. Run as the deployment owner, not with sudo."
fi
[[ -d "$config" && -w "$config" ]] \
  || fail "Configuration directory is not writable: $config. Run as the deployment owner; do not use sudo."

# Keep the lock file: unlinking it could give concurrent processes different locks.
exec 9>"$config/.herdr-integration.lock"
flock -x -w 30 9 || fail "Timed out waiting for another Herdr integration preparation."
ensuring=0
if [[ "$action" == ensure ]]; then
  ensuring=1
  state="$(herdr_pi_integration_state)" || exit 1
  if [[ "$state" == current ]]; then
    [[ -f "$extension" && -s "$extension" && -r "$extension" ]] \
      || fail "Upstream reports current but the official Herdr Pi extension is empty or unreadable."
    exit 0
  fi
  printf 'pi-docker: Herdr Pi integration is %s; installing/updating the official extension in shared configuration.\n' "$state" >&2
  action=install
fi
printf 'Herdr action: %s pi\nConfiguration: %q\n' "$action" "$config"
# Delegate all extension installation/update/removal to the official CLI.
if PI_CODING_AGENT_DIR="$config" "$herdr_bin" integration "$action" pi; then
  if [[ "$action" == install ]]; then
    [[ -f "$extension" && -s "$extension" && -r "$extension" ]] \
      || { printf 'herdr-extension: Herdr returned success but no readable, nonempty extension exists at %q. Check Pi integration support in this Herdr version.\n' "$extension" >&2; exit 1; }
    if ((ensuring)); then
      state="$(herdr_pi_integration_state)" || exit 1
      [[ "$state" == current ]] || fail "Herdr installation did not produce a current Pi integration."
    else
      printf 'Installed/updated the official extension at %q.\n' "$extension"
      printf 'Start a new container in a Herdr pane with pi /path/to/project.\n'
      printf 'Local diagnostics: pi /path/to/project --herdr-status\n'
      printf 'Herdr mode exposes the full local Herdr API to the container. No image rebuild needed.\n'
    fi
  else
    [[ ! -e "$extension" && ! -L "$extension" ]] \
      || { printf 'herdr-extension: Herdr returned success but the extension still exists at %q. Inspect it before retrying.\n' "$extension" >&2; exit 1; }
    printf 'Removed the Herdr extension. Configuration, credentials, sessions, and launch records were retained.\n'
    printf 'Use --no-herdr to prevent automatic reinstallation inside Herdr; existing processes are unchanged.\n'
  fi
else
  status=$?
  printf 'herdr-extension: Herdr %s failed (exit %s). Check the CLI output above; Docker-Pi did not install a substitute extension.\n' "$action" "$status" >&2
  exit "$status"
fi
