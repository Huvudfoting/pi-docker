# Copy to data/ollama.env at the repository root; never put real secrets here.
# Absolute host directory, created before starting Ollama:
OLLAMA_MODELS=/absolute/path/to/ollama/models
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_NETWORK=pi-ollama
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
