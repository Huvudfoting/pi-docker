#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p "$root/pi/config" "$root/pi/sessions/login"
export PI_CONFIG="$root/pi/config"
export PI_SESSIONS="$root/pi/sessions/login"
export PI_WORKSPACE="$root"
export PI_UID="$(id -u)"
export PI_GID="$(id -g)"
export OLLAMA_NETWORK="${OLLAMA_NETWORK:-pi-ollama}"
exec docker compose -f "$root/pi/compose.yaml" run --rm --build pi
